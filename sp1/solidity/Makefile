
ETH_RPC_URL ?= https://ethereum-sepolia-rpc.publicnode.com
CARTESI_SP1_CLI := $(abspath ../rust/target/release/cartesi-sp1-cli)
GUEST_ELF := $(abspath ../cpp/guest.elf)
FIXTURES_DIR := $(abspath test/fixtures)

.PHONY: dep build test coverage vkey clean help

help:
	@echo "SP1 Groth16 (seal) Integration Test"
	@echo ""
	@echo "  make test       Run integration tests (Sepolia fork)"
	@echo "  make dep        Install Foundry dependencies"
	@echo "  make vkey       Regenerate src/VKeyHash.sol"
	@echo "  make clean      Remove build artifacts"

dep:
	@if [ ! -d lib/forge-std ]; then forge install foundry-rs/forge-std --no-git; fi
	@if [ ! -d lib/sp1-contracts ]; then forge install succinctlabs/sp1-contracts --no-git; fi

# FORCE delegates freshness to cargo on every run, so a guest or host source edit
# reaches the binary -- and thus the vkey -- even when this Makefile is invoked
# directly. The generator below rewrites src/VKeyHash.sol only when it changes.
$(CARTESI_SP1_CLI): FORCE
	@$(MAKE) -C ../rust release

FORCE:

# Deriving the vkey needs a proving key, which the CPU prover can build in ~12s.
# No GPU required, so this stays runnable in CI and on a laptop.
src/VKeyHash.sol: $(CARTESI_SP1_CLI) $(GUEST_ELF)
	@VKEY=$$($(CARTESI_SP1_CLI) --guest-elf $(GUEST_ELF) vkey) && \
	{ echo '// This file is auto-generated by `make vkey` and should not be modified.'; \
	  echo '// SPDX-License-Identifier: Apache-2.0'; \
	  echo 'pragma solidity ^0.8.20;'; \
	  echo ''; \
	  echo 'library VKeyHash {'; \
	  echo '    bytes32 public constant CARTESI_SP1_STEP_VKEY ='; \
	  echo "        bytes32($$VKEY);"; \
	  echo '}'; \
	} > $@.tmp && \
	if cmp -s $@.tmp $@; then \
		rm -f $@.tmp; \
	else \
		mv $@.tmp $@ && echo "Generated $@ (vkey: $$VKEY)"; \
	fi

vkey:
	@rm -f src/VKeyHash.sol
	@$(MAKE) src/VKeyHash.sol

build: dep
	forge build

# The seal fixture is a real proof and cannot be regenerated without a GPU host,
# so fail with the reason rather than a missing-file error from forge.
test: dep src/VKeyHash.sol
	@test -f "$(FIXTURES_DIR)/seal.bin" || { echo "Error: seal fixture not found. It is a real Groth16 proof; regenerate with 'cartesi-sp1-cli prove ... groth16' then 'seal' on a GPU host."; exit 1; }
	forge test --fork-url $(ETH_RPC_URL) -vvv

coverage: dep src/VKeyHash.sol
	@test -f "$(FIXTURES_DIR)/seal.bin" || { echo "Error: seal fixture not found."; exit 1; }
	forge coverage --fork-url $(ETH_RPC_URL) --no-match-coverage '(test|lib)/'

clean:
	-@forge clean 2>/dev/null || true
	rm -rf cache out
	rm -f src/VKeyHash.sol
